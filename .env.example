# ============================================================
# NVIDIA 免费模型浏览 + OpenAI 兼容 API
# 复制本文件为 .env 后使用；也可以直接启动，在网页里完成首次配置。
# 只有 NVIDIA_API_KEY 是必填，其余保持注释即可。
# 改完重启服务生效。
# ============================================================

# 【必填】NVIDIA API Key
# 获取：https://build.nvidia.com → 任选一个模型 → Get API Key
NVIDIA_API_KEY=nvapi-在这里填你的Key

# ==================== 以下全部可选 ====================


# ---------- 端口 ----------
# 网页端口（默认 18788）
# NV_MODELS_PORT=18788

# API 端口（默认 18787）。Qoder / WorkBuddy / ZCode 填：
# http://127.0.0.1:18787/v1/chat/completions
# NV_GATEWAY_PORT=18787

# 监听地址：本机用默认 127.0.0.1；
# 服务器要让局域网/公网访问，改成 0.0.0.0（并务必设置下面的访问口令）。
# NV_MODELS_HOST=0.0.0.0
# NV_GATEWAY_HOST=0.0.0.0


# ---------- 自动采集 ----------
# 默认开启：每 8 小时检查一次，过期就重新抓取模型列表。
# 关闭自动采集（页面右上角“刷新”仍可手动采集）：
# NV_MODELS_AUTO=0
#
# 自定义检查间隔，支持 ms / s / m / h / d，默认 8h：
# NV_MODELS_TTL=8h
#
# 公开访问时隐藏页面右上角的“刷新”按钮，并拒绝远程手动刷新，
# 避免访客反复触发采集；服务器本机仍可调用刷新接口：
# NV_MODELS_SHOW_REFRESH=0


# ---------- 测速 ----------
# 默认开启，页面上可对单个模型点“测速”。
# 后台自动重扫过期结果，默认 24h：
# NV_MODELS_BENCHMARK_AUTO=24h
#
# 关闭后台自动重扫（单个测速仍可用）：
# NV_MODELS_BENCHMARK_AUTO=0
#
# 彻底关闭测速（页面不显示测速按钮）：
# NV_MODELS_BENCHMARK=0


# ---------- 翻译 ----------
# 默认用微软必应免费接口把英文简介翻译成中文，不需要配置。
# 关闭翻译，保留英文简介：
# NV_MODELS_TRANSLATE=off


# ---------- 网页设置页 ----------
# 网页右上角“设置”按钮，可在线修改 API Key、访问口令、自动采集、
# 测速、翻译等常用项，保存后立即生效；也可以在设置页里直接关闭设置页。
# 默认开启。不想让别人打开设置页时设为 0，设置按钮、设置页面和保存接口都会关闭：
# NV_MODELS_SETTINGS=0
# 恢复时把上面这一行改成 1（或删除这一行），重启服务即可。
# 端口、监听地址、HTTPS 等需要重启的项仍然只在 .env 里修改。


# ---------- 网页访问口令 ----------
# 本机访问可不设；局域网/公网访问必须设。
# 不设置时任何人都能打开面板；设置后打开网页会进入登录页，
# 输入这里的口令即可，登录状态保留 7 天，页面右上角可退出。
# 首次配置页面也可以直接设置或随机生成。
# NV_MODELS_TOKEN=自己定一个口令
#
# 忘记口令时直接查看本文件里的 NV_MODELS_TOKEN。
# 登录凭据用 data/session-secret 签名；改口令会让已登录的浏览器退出。
# 口令校验范围，remote=只校验非本机（默认），all=本机也要口令：
# NV_MODELS_AUTH_SCOPE=remote


# ---------- API 访问口令 ----------
# Qoder / WorkBuddy / ZCode 的 API Key 栏填这里的值。
# 本机访问可不设；局域网/公网暴露 API 时必须设。
# AUTH_TOKEN=自己定一个口令
#
# 口令校验范围，remote=只校验非本机（默认），all=本机也要口令：
# AUTH_SCOPE=remote


# ---------- 模型名称 ----------
# 客户端填模型短名即可，例如 glm-5.3-flash（官网地址里的 glm-5-3-flash 也兼容）；
# 短名到 NVIDIA 真实 ID 的映射由程序自动维护，不需要配置。


# ---------- 一键添加客户端配置 ----------
# 本机打开网页时，可以把模型直接写入 Qoder / WorkBuddy / ZCode 配置。
# 远程打开网页时，弹窗会按浏览器系统提供配置脚本下载：
# Windows 下载 .bat，双击运行，使用系统自带 PowerShell，无需安装 Python；
# Linux / macOS 下载 .sh，执行 bash nv-qoder-模型名.sh（需要 python3）。
# 文件名规则：nv-客户端-模型名；下载全部时为 nv-客户端-all，例如 nv-qoder-all.bat。
# 远程部署请设置下面的 NV_GATEWAY_URL，脚本会写入这个客户端可访问的地址。
# Linux 用 systemd 部署时，服务账号读写不到桌面用户的配置，远程脚本正是用于这种情况。
# 需要指定用户主目录时（服务账号必须有读写权限）：
# NV_CLIENTS_HOME=/home/yourname


# ---------- 服务器部署 ----------
# 客户端实际填写的地址。本机不用改。
# 直接 IP 访问：http://<服务器IP>:18787/v1
# 域名反代：    https://<你的域名>/v1
# NV_GATEWAY_URL=http://127.0.0.1:18787/v1

# ---------- 反向代理 ----------
# 用 nginx / Caddy 反代到本机 127.0.0.1 时开启。
# 只信任来自本机反代的 X-Real-IP / X-Forwarded-For，按真实客户端 IP 校验口令；
# 不开启会把所有访客当成“本机”，网页口令和本机一键添加会误判。
#
# Linux 服务器绑定域名可直接运行（会自动设置监听地址、公开地址和代理头）：
#   sudo bash /opt/nv-models/deploy/bind-domain.sh 你的域名
# 手动配置时，把 NV_MODELS_HOST / NV_GATEWAY_HOST 改成 127.0.0.1，
# 把 NV_GATEWAY_URL 改成 https://<你的域名>/v1，并取消下一行注释。
# 现成配置见 deploy/nginx.conf.example。
# NV_TRUST_PROXY=1
